# Copy to .env to override docker-compose dev defaults. Never commit .env.
POSTGRES_USER=orbyt
POSTGRES_PASSWORD=orbyt
POSTGRES_DB=orbyt
# Host ports; change them if 5432/6379 are already taken on your machine.
POSTGRES_PORT=5432
REDIS_PORT=6379
# Used by packages/db (tests, drizzle-kit). Keep the port in sync with POSTGRES_PORT.
DATABASE_URL=postgres://orbyt:orbyt@127.0.0.1:5432/orbyt
