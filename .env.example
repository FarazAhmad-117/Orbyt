# Copy to .env to override docker-compose dev defaults. Never commit .env.
POSTGRES_USER=orbyt
POSTGRES_PASSWORD=orbyt
POSTGRES_DB=orbyt
# Host ports; change them if 5432/6379 are already taken on your machine.
POSTGRES_PORT=5432
REDIS_PORT=6379
API_PORT=3001
WEB_PORT=3000
# Used by packages/db (tests, drizzle-kit). Keep the port in sync with POSTGRES_PORT.
DATABASE_URL=postgres://orbyt:orbyt@127.0.0.1:5432/orbyt

# API auth (better-auth). REQUIRED, at least 32 chars: generate with `openssl rand -base64 32`.
BETTER_AUTH_SECRET=
# The public URL people use to open Orbyt (the WEB origin, which proxies /api to the API).
# Use your https URL behind a reverse proxy. Unsubscribe and tracking links in emails use it too.
BETTER_AUTH_URL=http://localhost:3000
# Encrypts mailbox, AI and channel credentials: `openssl rand -base64 32`. Set it explicitly in
# production (otherwise a key is derived from BETTER_AUTH_SECRET and rotating that locks them).
ORBYT_ENCRYPTION_KEY=
# Allow user-supplied endpoints on private networks (mailboxes, webhooks, a local Ollama).
# Leave false on shared/cloud hosting (SSRF protection).
ORBYT_ALLOW_PRIVATE_URLS=false
# Where the web app forwards /api requests (set automatically in docker compose).
API_INTERNAL_URL=http://127.0.0.1:3001
# Optional: turn background loops off (e.g. to run them on one dedicated replica).
# ORBYT_SCHEDULER=off  ORBYT_SYNC=off  ORBYT_WORKFLOWS=off
# Optional provider endpoints (tests / proxies): TWILIO_API_BASE, RETELL_API_BASE
